# =============================================================================
# Base Layer — Netlify Redirects (Lovable SPA)
# =============================================================================

# Host canonicalization must stay above every path-only rule in this file.
# Netlify evaluates _redirects before netlify.toml and stops at the first
# match, so putting these in netlify.toml would let the catch-all below serve
# duplicate content first. Netlify upgrades HTTP to HTTPS before these rules
# and preserves the original query string automatically on 301 redirects.
https://baselayer.skin/*                    https://baselayerskin.co/:splat            301!
https://www.baselayer.skin/*                https://baselayerskin.co/:splat            301!
https://baselayerskin.netlify.app/*         https://baselayerskin.co/:splat            301!
https://www.baselayerskin.co/*              https://baselayerskin.co/:splat            301!

# Shopify checkout passthrough — Shopify has baselayerskin.co set as its
# primary domain, so Storefront-API checkoutUrls point at this host. DNS
# serves Netlify, so without these rules checkout links dead-end into the
# SPA fallback and no order can ever complete.
/cart/c/*                                   https://base-layer-skin.myshopify.com/cart/c/:splat        301!
/checkouts/*                                https://base-layer-skin.myshopify.com/checkouts/:splat     301!

# Product URL variants
/product                                    /face-cream       301
/shop                                       /face-cream       301
/products/*                                 /face-cream       301
# Server-side version of the client <Navigate> in App.tsx — required now that
# unknown routes 404 instead of falling back to the SPA shell
/checkout                                   /face-cream       301

# Blog → Articles (canonical)
/blog                                       /articles         301
# First match wins, so these five sit above the wildcard. Without them
# /blog/<slug> matched /blog/* first, landed on an /articles/<slug> that is
# itself a 301, and became a two-hop chain. Any slug added to the renamed list
# below needs its /blog twin here too.
/blog/3-step-skincare-routine-men           /articles/3-step-skincare-routine         301
/blog/skincare-ingredients-that-work        /articles/skincare-ingredients            301
/blog/skin-barrier-guide                    /articles/skincare-ingredients            301
/blog/post-shave-recovery                   /skin-concerns/post-shave-irritation      301
/blog/razor-burn-guide                      /skin-concerns/post-shave-irritation      301
/blog/*                                     /articles/:splat  301
/blogs/articles                             /articles         301

